# ============================================================================
# AORTAIQ — environment variables (EXAMPLE ONLY, no real secrets)
# Copy to `.env` locally (backend/.env) and fill values. On Render, set these
# in the service Environment tab (do NOT commit a real .env).
# ============================================================================

# ---- Backend ----
# Local dev uses docker-compose Postgres; in production use the Render Postgres connection string.
DATABASE_URL=postgres://aorta:aorta_local_dev@localhost:5432/aorta_iq

# Firebase Admin SDK — the ENTIRE service-account JSON as a single-line string.
# Generate: Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Session cookie settings
SESSION_COOKIE_NAME=__aorta_session
SESSION_COOKIE_MAX_AGE_MS=1209600000   # 14 days
SESSION_COOKIE_SECRET=change-me-in-production

# Comma-separated emails allowed to be promoted to Admin (contract: email allowlist for Admin)
ADMIN_EMAIL_ALLOWLIST=

# CORS: the frontend origin (Render static site URL, or http://localhost:5173 in dev)
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# ---- Cloudflare R2 (file storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ---- Frontend (.env in /frontend) ----
# Vite exposes only VITE_-prefixed vars to the browser.
VITE_API_BASE_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
